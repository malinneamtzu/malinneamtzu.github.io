<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} / {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">

  {# Link previews (Instagram, LinkedIn, WhatsApp…) read these tags. #}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{% if title %}{{ title }} / {% endif %}{{ site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/media/og-image.jpg">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">

  {# Start downloading the font right away, so the name does not flash. #}
  <link rel="preload" href="/fonts/Segmentor.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/style.css?v={{ buildTime }}">
  {# Colours, stroke and text font chosen in /admin → Theme (src/_data/theme.json).
     They override the defaults at the top of style.css. #}
  <style>
    {% if theme.textFont %}@font-face { font-family: "TextFont"; src: url("{{ theme.textFont | url }}"); font-display: swap; }{% endif %}
    :root {
      --bg: {{ theme.background or "#000000" }};
      --fg: {{ theme.text or "#fafafa" }};
      --muted: {{ theme.muted or "#fafafa" }};
      --line: {{ theme.lines or "#fafafa" }};
      --stroke-color: {{ theme.stroke or "#fafafa" }};
      --stroke: calc({{ theme.strokeWidth | default(0) }} * 1.333px);
      --accent: {{ theme.highlight or "#fafafa" }};
      {% if theme.textFont %}--font-text: "TextFont", "Segmentor", ui-monospace, monospace;{% endif %}
    }
  </style>
</head>
<body class="{{ bodyClass }}">
  {% set nav = [
    { label: "Projects", url: "/work/" },
    { label: "Type", url: "/type/" },
    { label: "Contact", url: "/contact/" }
  ] %}
  {% if bodyClass == "is-splash" %}
  {# Splash: only the big name, which follows the mouse / tilt. #}
  <header class="splash-header">
    <nav class="site-nav">
      {% for n in nav %}<a href="{{ n.url }}">{{ n.label }}</a>{% endfor %}
      <button class="motion-btn" type="button" hidden>Tilt to play</button>
    </nav>
  </header>
  {% else %}
  <header class="site-header">
    <a class="site-home" href="/">{{ site.name }}</a>
    <nav class="site-nav">
      {% for n in nav %}<a href="{{ n.url }}"{% if page.url.startsWith(n.url) %} aria-current="page"{% endif %}>{{ n.label }}</a>{% endfor %}
    </nav>
  </header>
  {% endif %}

  <main>
    {{ content | safe }}
  </main>

  {% if bodyClass != "is-splash" %}
  <footer class="site-footer">
    <span>© {{ year }} {{ site.name }}</span>
    <a href="mailto:{{ site.email }}">{{ site.email }}</a>
  </footer>
  {% endif %}

  <script src="/script.js?v={{ buildTime }}"></script>
</body>
</html>
