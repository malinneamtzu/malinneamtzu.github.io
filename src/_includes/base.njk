<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} / {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">

  {# Link previews (Instagram, LinkedIn, WhatsApp…) read these tags. #}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{% if title %}{{ title }} / {% endif %}{{ site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/media/og-image.jpg">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">

  {# Start downloading the font right away, so the name does not flash. #}
  <link rel="preload" href="/fonts/Segmentor.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/style.css">
  {# Colours, stroke and text font chosen in /admin → Theme (src/_data/theme.json).
     They override the defaults at the top of style.css. #}
  <style>
    {% if theme.textFont %}@font-face { font-family: "TextFont"; src: url("{{ theme.textFont }}"); font-display: swap; }{% endif %}
    :root {
      --bg: {{ theme.background or "#000000" }};
      --fg: {{ theme.text or "#d9d9d9" }};
      --muted: {{ theme.muted or "#8a8a8a" }};
      --line: {{ theme.lines or "#5c5c5c" }};
      --stroke-color: {{ theme.stroke or "#999999" }};
      --stroke: calc({{ theme.strokeWidth | default(1) }} * 1.333px);
      --accent: {{ theme.highlight or "#e01ee0" }};
      {% if theme.textFont %}--font-text: "TextFont", "Segmentor", ui-monospace, monospace;{% endif %}
    }
  </style>
</head>
<body class="{{ bodyClass }}">
  <header class="site-header">
    <a class="site-name seg" href="/" aria-label="{{ site.name }}, home">{{ site.name }}</a>
    <div class="site-bar">
      <span class="site-tagline">{{ site.tagline }}<span class="site-location">, {{ site.location }}</span></span>
      <nav class="site-nav">
        <a href="/work/"{% if page.url.startsWith("/work/") %} aria-current="page"{% endif %}>Work</a>
        <a href="/timeline/"{% if page.url == "/timeline/" %} aria-current="page"{% endif %}>Timeline</a>
        <a href="/info/"{% if page.url == "/info/" %} aria-current="page"{% endif %}>Info</a>
        <button class="motion-btn" type="button" hidden>Tilt to play</button>
      </nav>
    </div>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <a href="mailto:{{ site.email }}">{{ site.email }}</a>
    <span>© {{ year }} {{ site.name }}</span>
  </footer>

  <script src="/script.js"></script>
</body>
</html>
