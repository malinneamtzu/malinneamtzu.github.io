---
layout: base.njk
bodyClass: is-project
pagination:
  data: projects
  size: 1
  alias: p
permalink: "/work/{{ p.id }}/"
eleventyComputed:
  title: "{{ p.title }}"
  description: "{{ p.summary }}"
---
<article class="project">
  <h1 class="project-title">{{ p.title }}</h1>

  <div class="project-info">
    <dl class="project-meta">
      {% if p.year %}<dt>Year</dt><dd>{{ p.year }}</dd>{% endif %}
      {% if p.client %}<dt>Client</dt><dd>{{ p.client | mdInline | safe }}</dd>{% endif %}
      {% if p.role %}<dt>Role</dt><dd>{{ p.role | mdInline | safe }}</dd>{% endif %}
      <dt>Field</dt><dd>{{ p.tags | join(", ") }}</dd>
    </dl>
    <div class="project-text">
      {{ p.intro | md | safe }}
      {% if p.links %}
      <ul class="project-links">
        {% for l in p.links %}<li><a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }}</a></li>{% endfor %}
      </ul>
      {% endif %}
    </div>
  </div>

  {# Gallery in rows (see "gallery" in _data/projects.js). In a row every
     image gets a share of the width equal to its width/height ratio (--r),
     so all images in the row have the same height. #}
  <div class="gallery">
    {% for row in p.rows %}
    {% if row.section %}<h2 class="gallery-section">— {{ row.section }}</h2>{% endif %}
    {% set rowRatio = 0 %}{% for g in row.items %}{% set rowRatio = rowRatio + g.ratio %}{% endfor %}
    <div class="gallery-row" data-count="{{ row.items.length }}">
      {% for g in row.items %}
      <figure style="--r: {{ g.ratio | round(4) }}">
        {% if g.image.endsWith(".mp4") %}
        {# Videos play silently on a loop, like a moving image. #}
        <video src="{{ g.image }}" autoplay muted loop playsinline preload="metadata" aria-label="{{ (g.caption | plain) or (p.title + ', video') }}"></video>
        {% else %}
        <img src="{{ g.image }}" alt="{{ (g.caption | plain) or (p.title + ', image') }}" sizes="(min-width: 700px) {{ (100 * g.ratio / rowRatio) | round(1) }}vw, {{ 100 if row.items.length == 1 else 50 }}vw">
        {% endif %}
        {% if g.caption %}<figcaption>{{ g.caption | mdInline | safe }}</figcaption>{% endif %}
      </figure>
      {% endfor %}
    </div>
    {% endfor %}
  </div>

  {# Previous / next: typefaces page through typefaces, projects through projects. #}
  {% if p.typeface %}{% set group = projects | selectattr("typeface") %}{% else %}{% set group = projects | rejectattr("typeface") %}{% endif %}
  {% set prev = group | neighbour(p.id, -1) %}
  {% set next = group | neighbour(p.id, 1) %}
  <nav class="project-pager">
    <a href="/work/{{ prev.id }}/">« {{ prev.title }}</a>
    {% if p.typeface %}<a href="/type/">All typefaces</a>{% else %}<a href="/work/">All projects</a>{% endif %}
    <a href="/work/{{ next.id }}/">{{ next.title }} »</a>
  </nav>
</article>
