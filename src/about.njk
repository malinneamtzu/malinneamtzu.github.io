---
layout: base.njk
title: About
bodyClass: is-about
permalink: /about/
---
{# About: one line about me (site.json → bio), links, then the CV
   (src/_data/cv.json). Email and social links are on the splash page,
   top right. #}
<div class="about">
  <section class="about-bio">
    {{ site.bio | md | safe }}
  </section>
  <ul class="plain-list about-links">
    {% for l in site.links %}<li><a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }}</a></li>{% endfor %}
  </ul>
</div>

<div class="cv" id="cv">
  {% for section in cv.sections %}
  <section>
    <h2>{{ section.title }}</h2>
    <ul class="cv-list">
      {% for item in section.items %}
      <li><span class="when">{{ item.when }}</span><span class="what">{{ item.what | mdInline | safe }}</span></li>
      {% endfor %}
    </ul>
  </section>
  {% endfor %}
</div>
