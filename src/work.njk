---
layout: base.njk
title: Projects
bodyClass: is-work
permalink: /work/
---
{# All projects as one list, newest first (sorted in _data/projects.js):
   project, client, year. On a computer the cover appears next to the
   pointer while hovering a row (style.css "Index", script.js §3). #}
<ol class="index">
  <li class="index-head" aria-hidden="true">
    <span>Project</span><span>Client</span><span>Year</span>
  </li>
  {% for p in projects %}
  <li>
    <a class="index-row" href="/work/{{ p.id }}/">
      <span class="index-title">{{ p.title }}</span>
      <span class="index-client">{{ p.client | plain }}</span>
      <span class="index-year">{{ p.year }}</span>
      {% if p.cover %}<img class="index-thumb" src="{{ p.cover }}" alt="" sizes="320px">{% endif %}
    </a>
  </li>
  {% endfor %}
</ol>
