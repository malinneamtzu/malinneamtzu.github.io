---
layout: base.njk
title: Contact
bodyClass: is-contact
permalink: /contact/
---
<div class="contact">
  <section class="contact-main">
    <p class="contact-email"><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    <ul class="plain-list">
      {% for l in site.social %}<li><a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }}</a></li>{% endfor %}
    </ul>
  </section>

  <section class="contact-bio">
    {{ site.bio | md | safe }}
    <ul class="plain-list">
      {% for l in site.links %}<li><a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }}</a></li>{% endfor %}
    </ul>
  </section>
</div>

{# CV: sections and entries come from src/_data/cv.json #}
<div class="cv" id="cv">
  {% for section in cv.sections %}
  <section>
    <h2>{{ section.title }}</h2>
    <ul class="cv-list">
      {% for item in section.items %}
      <li><span class="when">{{ item.when }}</span><span class="what">{{ item.what | mdInline | safe }}</span></li>
      {% endfor %}
    </ul>
  </section>
  {% endfor %}
</div>
